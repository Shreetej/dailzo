# Local development. Copy to .env and fill in; .env is not tracked.
#
# In a deployment, set these as the platform's own environment variables —
# never ship a .env in the image (.dockerignore excludes it).

# Either DATABASE_URL on its own (what Railway/Render/Fly inject for an
# attached Postgres) …
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# … or the parts, for a local server.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=dailzo
DB_SSLMODE=disable

# The host sets PORT itself; APP_PORT is the local override.
APP_PORT=2193
APP_ENV=development

# Required. 32+ random characters — `openssl rand -base64 48`.
# Changing it invalidates every issued token.
JWT_SECRET=

# Comma-separated origins, or empty for the permissive development default.
CORS_ORIGINS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Pool sizing; the defaults (10/2) are dev-scale.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2

# Set false to start without applying pending migrations.
# RUN_MIGRATIONS=true
